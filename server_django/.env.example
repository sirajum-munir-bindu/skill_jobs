# ==========================================
# Skill Jobs Django Backend Environment Config
# ==========================================

# Secret Key (Generate a random string for production)
SECRET_KEY=change-me-to-a-secure-random-50-character-secret-key

# Debug Mode (Set to False in production)
DEBUG=False

# Allowed Hosts (Comma-separated hostnames or IP addresses)
ALLOWED_HOSTS=*

# Database URL (Format: postgres://user:password@host:port/dbname)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skilljobs_db

# Direct Database credentials fallback (used if DATABASE_URL is not provided)
DB_NAME=skilljobs_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
ALLOWED_ORIGINS=https://skill.jobs,https://your-frontend.vercel.app
