# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-skill-jobs-nextgen-backend-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/skilljobs_db

# CORS Allowed Origins (Comma separated or * via CORS_ALLOW_ALL_ORIGINS)
CORS_ALLOW_ALL_ORIGINS=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port
PORT=5000
